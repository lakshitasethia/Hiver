# Copy to .env (auto-loaded) or export in your shell.

# --- LLM: reply generation + LLM-judge + zero-shot classification baseline ---
# "auto" backend order: Groq (if GROQ_API_KEY) -> Gemini (if GOOGLE_API_KEY) -> offline fake.
SUPPORT_AGENT_LLM=auto

# Groq — free key at https://console.groq.com/keys. Generous free tier
# (~1000 req/day, ~8k tokens/min per model); this is the recommended backend.
GROQ_API_KEY=
SUPPORT_AGENT_GROQ_MODEL=openai/gpt-oss-20b

# Gemini — free key at https://aistudio.google.com/apikey. Free tier is only
# ~20 requests/day/model, so useful for a small run only.
GOOGLE_API_KEY=
SUPPORT_AGENT_LLM_MODEL=gemini-flash-lite-latest

# LLM-judge on a different model family than the generator (reduces
# "model grades its own output" bias). Leave unset to judge with the same model.
SUPPORT_AGENT_JUDGE_MODEL=qwen/qwen3.8-27b

# Space out LLM calls (seconds) to stay under a tokens/min cap on a long eval run.
SUPPORT_AGENT_LLM_MIN_INTERVAL=0

# --- Embeddings ---
# "st" = sentence-transformers all-MiniLM-L6-v2 (local, ~90 MB download, no key).
# "hashing" = deterministic hashed n-grams, zero download (used by CI/tests).
SUPPORT_AGENT_EMBEDDER=st

# --- Real dataset download (make data) ---
# Any one of:
#   KAGGLE_API_TOKEN=KGAT_...              (newer, single access token)
#   ~/.kaggle/access_token  with that token
#   ~/.kaggle/kaggle.json   {"username":...,"key":...}   (classic)
#   KAGGLE_USERNAME + KAGGLE_KEY below
# Or download twcs.csv by hand from the dataset page -> data/twcs.csv (no auth).
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
