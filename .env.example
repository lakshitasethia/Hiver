# Copy to .env (auto-loaded) or export in your shell.

# --- LLM (reply generation + LLM-judge + zero-shot classification baseline) ---
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Backend select. "auto" = Gemini if GOOGLE_API_KEY is set, else the offline fake.
# Force with "gemini" or "fake".
SUPPORT_AGENT_LLM=auto
SUPPORT_AGENT_LLM_MODEL=gemini-flash-latest

# --- Embeddings ---
# "st" = sentence-transformers all-MiniLM-L6-v2 (local, ~90 MB download, no key).
# "hashing" = deterministic hashed n-grams, zero download (used by CI/tests).
SUPPORT_AGENT_EMBEDDER=st

# --- Real dataset download (make data) ---
# Needs a Kaggle account. Put kaggle.json at ~/.kaggle/kaggle.json (chmod 600),
# or set these two:
KAGGLE_USERNAME=
KAGGLE_KEY=
